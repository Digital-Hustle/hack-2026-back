# Copy to .env and fill required values before running compose.full.yaml.
# Keep real passwords and keys only in .env (ignored by Git).
AUTH_DB_PASSWORD=
ORCHESTRATOR_DB_PASSWORD=

# Exact public HTTPS origin of the frontend, without a trailing slash or path.
AUTH_ALLOWED_ORIGINS=https://localhost
AUTH_MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL_ENABLED=false

# Matching RSA keys in base64 DER: PKCS#8 private key and X.509 public key.
# See docs/AUTH_PROFILE_RUNTIME.md for generation commands.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_KEY_ID=cashflow-1
AUTH_JWT_ISSUER=https://auth.cashflow.internal
AUTH_JWT_AUDIENCE=cashflow-api
# Base64 of at least 32 cryptographically random bytes.
AUTH_OTP_HMAC_SECRET=

# Optional AI assistant. Set the endpoint, model and credentials for your provider.
# When these two values are empty, compose.full.yaml supplies its existing defaults.
OMNIROUTE_BASE_URL=
OMNIROUTE_MODEL=
OMNIROUTE_API_KEY=
